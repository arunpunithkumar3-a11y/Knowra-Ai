# ============================================================
# Knowra Environment Configuration Template
# Duplicate this file to '.env' and fill in your credentials.
# ============================================================

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowra
# For local Redis: redis://localhost:6379/0
# For Upstash Managed Cloud Redis: rediss://default:<UPSTASH_TOKEN>@<UPSTASH_HOST>:6379
REDIS_URL=redis://localhost:6379/0

# Security / Authentication
JWT_SECRET=replace_with_a_super_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256

# Vector Store (Qdrant)
# For local Qdrant container: http://localhost:6333
# For Qdrant Cloud: https://xxxx.aws.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_or_empty_for_local

# LLM & Embedding Providers (NVIDIA NIM / Groq)
NVIDIA_API_KEY=nvapi-your_nvidia_nim_api_key
GROQ_API_KEY=gsk_your_groq_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
RERANKER_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2
LLM_MODEL=meta/llama-3.3-70b-instruct
JUDGE_MODEL=meta/llama-3.3-70b-instruct

# Chunking & RAG Retrieval Hyperparameters
PARENT_CHUNK_SIZE=350
PARENT_CHUNK_OVERLAP=50
CHILD_CHUNK_SIZE=75
CHILD_CHUNK_OVERLAP=20
WINDOW_SIZE=2
DENSE_K=4
SPARSE_K=3
RRF_K=60
TOP_K_RERANK=3

# Email Service (SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@knowra.ai
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Knowra
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# Host Domain
DOMAIN=localhost:8000
